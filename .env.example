# Required: local path to the NVFP4 checkpoint.
# Download once (109 GB) — needs NVMe, not spinning disk or network mount:
#   hf download starkweatherdigital/qwen3.8-flash-next-nvfp4 --local-dir /mnt/models/qwen3.8-flash-next-nvfp4
MODEL_DIR=/mnt/models/qwen3.8-flash-next-nvfp4

# Optional overrides (defaults in docker-compose.yml):
# IMAGE=jalapeno/vllm-gb10-flashnext:0.28-sm121-r9
# CONTAINER_NAME=qwen3.8-flash-next
