+# BCN-JAL-I0FIX (Project Jalapeño cand-I0, M5, fix F-A / S3): env gate for
+# pinned, non-blocking H2D of the per-request index tensors built in
+# PleShortConvAttentionMetadataBuilder.build. A pageable ``.to(device)``
+# performs ``cudaMemcpyAsync`` + ``cudaStreamSynchronize`` on the current
+# stream, so while the previous step's forward/lm_head tail is still in flight
+# the CPU freezes exactly when it should be preparing the next step (measured
+# 6.4-15.5 ms sync, median 13.7 ms in 56% of steady decode steps). With the
+# flag on, the same bytes are staged through pinned memory and enqueued
+# non-blocking on the same stream (async_tensor_h2d, the in-tree helper this
+# function already uses for ``spec_sequence_masks`` ~45 lines above), which is
+# bit-identical (same values, same stream-ordered consumers) but removes the
+# implicit full-stream drain. Default off = today's blocking copies.
+# VLLM_ASYNC_ATTN_META_H2D_ENV is asserted by the recipe Dockerfile CHECKS.
+_ASYNC_ATTN_META_H2D_ENV = "VLLM_ASYNC_ATTN_METADATA_H2D"
+_ASYNC_ATTN_META_H2D = os.environ.get(_ASYNC_ATTN_META_H2D_ENV, "0").lower() in (
+    "1",
+    "true",
+    "yes",
+    "on",
+)
+# Sticky: once a pinned staging allocation has failed (host OOM), stop
+# retrying and keep today's blocking copy semantics for the rest of the run.
+_async_h2d_pin_broken = False
+
+
+def _maybe_async_h2d(cpu_tensor: torch.Tensor, device: str | torch.device):
+    """F-A: copy a CPU index tensor to ``device`` without a stream drain.
+
+    Bit-identical to ``cpu_tensor.to(device)``: same source bytes, same dtype,
+    same element order, enqueued on the current stream ahead of the same
+    device-side consumers. Only the transfer mechanism changes (pinned staging
+    + non_blocking instead of pageable + implicit sync). Falls back to the
+    blocking copy when pinning fails.
+    """
+    global _async_h2d_pin_broken
+    if not _ASYNC_ATTN_META_H2D or _async_h2d_pin_broken:
+        return cpu_tensor.to(device)
+    try:
+        return async_tensor_h2d(cpu_tensor, device=device)
+    except RuntimeError:
+        # torch.cuda.OutOfMemoryError (pinned host allocation) subclasses
+        # RuntimeError; fall back permanently to the pageable blocking copy.
+        _async_h2d_pin_broken = True
+        return cpu_tensor.to(device)
+
 
