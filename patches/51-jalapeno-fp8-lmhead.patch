+class JalapenoFp8MarlinEmbeddingMethod(UnquantizedEmbeddingMethod):
+    """Same FP8(E4M3, per-channel)/marlin treatment for ParallelLMHead
+    (lm_head). LogitsProcessor calls quant_method.apply(lm_head, hidden)
+    — the same custom-op dispatch as the linear method applies."""
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        JalapenoFp8MarlinLinearMethod.process_weights_after_loading(self, layer)
+
+    def apply(self, layer, x: torch.Tensor, bias: torch.Tensor | None = None):
+        n = getattr(layer, "output_size", None) or layer.num_embeddings
+        k = getattr(layer, "input_size", None) or layer.embedding_dim
+        return torch.ops.vllm.jalapeno_fp8_proj_linear(
+            x, layer.marlin_qweight, layer.marlin_scales, layer.workspace,
+            layer.fp8_rowmajor, layer.fp8_scale32, n, k, bias)
+
