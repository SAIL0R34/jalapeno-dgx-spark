+class _JalapenoSkinnyWarmupProvider:
+    """CuTeDSL warmup provider that tolerates compile failure on sm_121.
+
+    The stock request_warmup_configs path lets a cute.compile exception abort
+    engine startup; for cand-G1 a failure must instead leave the route on
+    cuBLAS (the dispatcher poisons the route when it next sees it).
+    """
+
+    def __init__(self, dtype: torch.dtype, configs: set[SkinnyGemmConfig]) -> None:
+        self._dtype = dtype
+        self._configs = configs
+
+    def _safe_compile(self, dtype: torch.dtype, config: SkinnyGemmConfig) -> None:
+        try:
+            shape_dynamic_skinny_gemm._compile(dtype, config, False)
+        except Exception as exc:  # noqa: BLE001 - degrade to cuBLAS fallback
+            routes = [
+                (n, k, config.num_rows)
+                for (n, k), plan in _resolve_effective_plans().items()
+                if config in plan.values()
+            ]
+            for route in routes:
+                _failed_routes.add(route)
+            logger.warning(
+                "Jalapeno cand-G1: CuTeDSL compile failed for %s (%s: %s); "
+                "%d route(s) stay on cuBLAS",
+                config,
+                type(exc).__name__,
+                exc,
+                len(routes),
+            )
+
+    def get_cutedsl_warmup_compile_units(self):
+        from vllm.model_executor.warmup.cutedsl_warmup import CuTeDSLCompileUnit
+
+        return tuple(
+            CuTeDSLCompileUnit(
+                name="jalapeno skinny GEMM",
+                key=("jalapeno-skinny-gemm", self._dtype, config),
+                compile=partial(self._safe_compile, self._dtype, config),
+            )
+            for config in sorted(
+                self._configs,
+                key=lambda c: (
+                    c.num_rows,
+                    c.block_size,
+                    c.outputs_per_block,
+                    c.k_unroll,
+                    c.vector_width,
+                    c.static_k or 0,
+                ),
+            )
+        )
 
