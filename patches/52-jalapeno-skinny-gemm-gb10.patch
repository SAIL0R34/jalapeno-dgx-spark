 def _is_sm103() -> bool:
     return current_platform.is_device_capability((10, 3))
 
 
+def _is_sm121() -> bool:
+    return current_platform.is_device_capability((12, 1))
+
+
+def _jalapeno_tokens() -> set[str]:
+    mode = os.environ.get(JALAPENO_SKINNY_ENV, "0").strip().lower()
+    if not mode or mode in ("0", "off", "false", "no"):
+        return set()
+    if mode in ("1", "on", "true", "yes"):
+        return set(_JALAPENO_SKINNY_DEFAULT)
+    tokens = {token.strip() for token in mode.split(",") if token.strip()}
+    if "all" in tokens:
+        return set(JALAPENO_SKINNY_FAMILIES)
+    return tokens & set(JALAPENO_SKINNY_FAMILIES)
+
+
+def _resolve_effective_plans() -> dict[tuple[int, int], dict[int, SkinnyGemmConfig]]:
+    global _effective_plans
+    if _effective_plans is None:
+        if _is_sm103():
+            # sm_103: the shipped TP=4 table, exactly as before.
+            _effective_plans = QWEN38NEXT_GEMM_PLANS
+        else:
+            shapes: set[tuple[int, int]] = set()
+            for token in _jalapeno_tokens():
+                shapes |= JALAPENO_SKINNY_FAMILIES[token]
+            if shapes and _is_sm121() and shape_dynamic_skinny_gemm.is_available():
+                merged = dict(QWEN38NEXT_GEMM_PLANS)
+                merged.update(JALAPENO_GEMM_PLANS)
+                _effective_plans = {
+                    key: plan for key, plan in merged.items() if key in shapes
+                }
+            else:
+                _effective_plans = {}
+    return _effective_plans
+
+
